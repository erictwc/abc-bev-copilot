# Copy to .env (make setup does this) and fill in. .env is gitignored and the
# pre-commit hook refuses to commit it.

# claude path: Anthropic API key. Put a monthly cap on it in the Anthropic console too.
ANTHROPIC_API_KEY=

# cloud path: hosted Qwen through an OpenAI-compatible API. Provider not chosen yet (see DECISIONS.md).
CLOUD_QWEN_BASE_URL=
CLOUD_QWEN_API_KEY=

# local path: Ollama on the GEEKOM box, home network only. Never a public address.
# Example: http://192.168.1.50:11434
OLLAMA_HOST=

# The $20 monthly spend cap is NOT set here on purpose. It is enforced in code (T4)
# so that changing it is a reviewed commit, not an environment edit.
