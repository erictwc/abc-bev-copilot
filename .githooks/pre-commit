#!/usr/bin/env python3
"""Secret scan: refuse a commit that adds anything shaped like a key.

Standard library only, so the guard on the secrets path adds no dependency.
It reads the staged diff, not the working tree, because the staged diff is
exactly what the commit will contain. Only added lines are checked, so an old
line elsewhere in a file cannot block an unrelated commit.

`git commit --no-verify` skips every hook, this one included. That is git's
rule, not a gap here; do not use it to get past this check.
"""
import re
import subprocess
import sys

PATTERNS = [
    ("Anthropic API key", re.compile(r"sk-ant-[A-Za-z0-9_\-]{20,}")),
    ("OpenAI-style API key", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_\-]{20,}")),
    ("AWS access key ID", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("git host token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b")),
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    # A long literal assigned to anything named like a credential. An empty
    # value (as in .env.example) or a short placeholder does not match.
    ("credential assignment", re.compile(
        r"(?i)\b[A-Z0-9_]*(?:api_?key|secret|token|password)[A-Z0-9_]*\s*[:=]\s*"
        r"['\"]?[A-Za-z0-9_\-/+=.]{20,}")),
]

# .env holds the real keys. .env.example is the one tracked copy, kept empty.
ENV_FILE = re.compile(r"(?:^|/)\.env(?:\.[^/]*)?$")
ENV_ALLOWED = re.compile(r"(?:^|/)\.env\.example$")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def main():
    problems = []

    for path in git("diff", "--cached", "--name-only", "--diff-filter=ACMR").splitlines():
        if ENV_FILE.search(path) and not ENV_ALLOWED.search(path):
            problems.append(f"{path}: a .env file is staged; keys belong in an untracked .env only")

    path, line_no = None, 0
    for line in git("diff", "--cached", "-U0", "--no-color", "--diff-filter=ACMR").splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("@@"):
            line_no = int(re.search(r"\+(\d+)", line).group(1))
        elif line.startswith("+"):
            for name, pattern in PATTERNS:
                if pattern.search(line):
                    problems.append(f"{path}:{line_no}: looks like a {name}")
            line_no += 1

    if problems:
        print("secret scan: commit blocked.", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        print("Move the value into .env (gitignored) and unstage it.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
